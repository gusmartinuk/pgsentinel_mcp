{% extends "base.html.j2" %}
{% block content %}
<style>
.req { color: var(--danger); font-weight: 600; }
.opt { color: var(--muted); font-size: 0.7rem; font-weight: 400; }
fieldset { border: 1px solid var(--border); border-radius: 6px; padding: 1rem; margin-bottom: 1rem; }
legend { font-size: 0.8rem; font-weight: 600; color: var(--accent); padding: 0 0.5rem; }
.host-row { display: flex; gap: 1rem; }
.host-row .form-group { flex: 1; }
#test-result { font-size: 0.8rem; padding: 0.5rem; border-radius: 6px; margin-top: 0.5rem; }
#test-result.ok { background: rgba(63,185,80,0.15); color: var(--success); border: 1px solid rgba(63,185,80,0.3); }
#test-result.err { background: rgba(248,81,73,0.15); color: var(--danger); border: 1px solid rgba(248,81,73,0.3); }
</style>

<h1>{{ 'New PostgreSQL Target' if is_new else 'Edit PostgreSQL Target' }}</h1>
<div class="card">
  <form method="post" action="{{ '/admin/postgres/new' if is_new else '/admin/postgres/' + target.id + '/edit' }}" autocomplete="off" autocapitalize="off" spellcheck="false">

    <fieldset><legend>Identity</legend>
      <div class="form-row">
        <div class="form-group"><label for="name">Name <span class="req">*</span></label><input id="name" name="name" value="{{ target.name }}" required autofocus></div>
        <div class="form-group">
          <label for="server_id">Server <span class="opt">(optional)</span></label>
          <select id="server_id" name="server_id">
            <option value="">-- none --</option>
            {% for s in servers %}<option value="{{ s.id }}" {{ 'selected' if target.server_id == s.id }}>{{ s.name }} ({{ s.connection_mode }})</option>{% endfor %}
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset><legend>Connection</legend>
      <div class="form-row">
        <div class="form-group">
          <label for="connection_mode">Connection Mode <span class="req">*</span></label>
          <select id="connection_mode" name="connection_mode" onchange="toggleHostRow(this.value)">
            <option value="docker_exec_psql_over_ssh" {{ 'selected' if target.connection_mode == 'docker_exec_psql_over_ssh' }}>Docker exec psql (SSH)</option>
            <option value="ssh_tunnel_direct_postgres" {{ 'selected' if target.connection_mode == 'ssh_tunnel_direct_postgres' }}>SSH Tunnel + Direct PostgreSQL</option>
            <option value="postgres_direct_tcp" {{ 'selected' if target.connection_mode == 'postgres_direct_tcp' }}>PostgreSQL Direct TCP</option>
            <option value="postgres_direct_tls" {{ 'selected' if target.connection_mode == 'postgres_direct_tls' }}>PostgreSQL Direct TLS</option>
          </select>
        </div>
        <div class="form-group"><label for="port">Port</label><input id="port" name="port" type="number" value="{{ target.port }}" min="1" max="65535"></div>
      </div>
      <div class="form-row host-row" id="host-row" style="display:{{ 'flex' if target.connection_mode in ('ssh_tunnel_direct_postgres','postgres_direct_tcp','postgres_direct_tls') else 'none' }}">
        <div class="form-group"><label for="host">Host <span class="req">*</span></label><input id="host" name="host" value="{{ target.host }}" placeholder="127.0.0.1, 10.0.0.1, or db.example.com"></div>
      </div>
      <div class="form-row" id="container-row" style="display:{{ 'flex' if target.connection_mode == 'docker_exec_psql_over_ssh' else 'none' }}">
        <div class="form-group"><label for="container_name">Container Name <span class="req">*</span></label><input id="container_name" name="container_name" value="{{ target.container_name }}" placeholder="postgres"></div>
      </div>
      <script>
        function toggleHostRow(mode) {
          var needsHost = (mode === 'ssh_tunnel_direct_postgres' || mode === 'postgres_direct_tcp' || mode === 'postgres_direct_tls');
          var needsContainer = (mode === 'docker_exec_psql_over_ssh');
          document.getElementById('host-row').style.display = needsHost ? 'flex' : 'none';
          document.getElementById('container-row').style.display = needsContainer ? 'flex' : 'none';
          if (!needsHost) document.getElementById('host').value = '';
        }
      </script>
    </fieldset>

    <fieldset><legend>Credentials</legend>
      <div class="form-row">
        <div class="form-group"><label for="database_name">Database Name <span class="req">*</span></label><input id="database_name" name="database_name" value="{{ target.database_name }}" required placeholder="appdb"></div>
        <div class="form-group"><label for="readonly_username">Readonly Username <span class="req">*</span></label><input id="readonly_username" name="readonly_username" value="{{ target.readonly_username }}" required></div>
      </div>
      <div class="form-group">
        <label for="readonly_password">Readonly Password <span class="req">*</span></label>
        {% if not is_new %}<div class="muted" style="margin-bottom:0.25rem">Stored, leave blank to keep existing</div>{% endif %}
        <input id="readonly_password" name="readonly_password" type="password" autocomplete="new-password" placeholder="Enter password" {{ 'required' if is_new }}>
      </div>
      {% if target.connection_mode in ('postgres_direct_tls',) %}
      <div class="form-row">
        <div class="form-group">
          <label for="ssl_mode">SSL Mode</label>
          <select id="ssl_mode" name="ssl_mode">
            <option value="disable" {{ 'selected' if target.ssl_mode == 'disable' }}>disable</option>
            <option value="prefer" {{ 'selected' if target.ssl_mode == 'prefer' }}>prefer</option>
            <option value="require" {{ 'selected' if target.ssl_mode == 'require' }}>require</option>
          </select>
        </div>
        <div class="form-group"></div>
      </div>
      {% endif %}
      <button type="button" class="secondary" onclick="testConnection()" style="margin-bottom:0.5rem">Test Connection</button>
      <div id="test-result"></div>
    </fieldset>

    <fieldset><legend>Access Control</legend>
      <div class="form-row">
        <div class="form-group"><label for="allowed_schemas_text">Allowed Schemas <span class="opt">(comma-separated, default: public)</span></label><input id="allowed_schemas_text" name="allowed_schemas_text" value="{{ target.allowed_schemas | join(', ') }}" placeholder="public"></div>
        <div class="form-group"><label for="allowed_tables_text">Allowed Tables <span class="opt">(comma-separated, blank = none unless allow-all is checked)</span></label><input id="allowed_tables_text" name="allowed_tables_text" value="{{ target.allowed_tables | join(', ') }}" placeholder="users,orders"></div>
      </div>
      <div class="form-row">
        <div class="form-group" style="display:flex;align-items:center;gap:0.5rem"><input type="checkbox" id="allow_all_tables" name="allow_all_tables" value="true" {{ 'checked' if target.allow_all_tables }}><label for="allow_all_tables" style="margin:0">Allow all tables for this target</label></div>
        <div class="form-group" style="display:flex;align-items:center;gap:0.5rem"><input type="checkbox" id="sql_query_enabled" name="sql_query_enabled" value="true" {{ 'checked' if target.sql_query_enabled }}><label for="sql_query_enabled" style="margin:0">Enable generic SQL query tool for this target</label></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label for="sensitive_columns_text">Sensitive Columns <span class="opt">(comma-separated)</span></label><input id="sensitive_columns_text" name="sensitive_columns_text" value="{{ target.sensitive_columns | join(', ') }}" placeholder="password,token,secret"></div>
        <div class="form-group"><label for="max_rows">Max Rows</label><input id="max_rows" name="max_rows" type="number" value="{{ target.max_rows }}" min="1" max="1000"></div>
      </div>
    </fieldset>

    <div class="form-row">
      <div class="form-group"><label for="notes">Notes <span class="opt">(optional)</span></label><input id="notes" name="notes" value="{{ target.notes }}"></div>
      <div class="form-group" style="display:flex;align-items:center;gap:0.5rem;padding-top:1.25rem"><input type="checkbox" id="enabled" name="enabled" value="true" {{ 'checked' if target.enabled }}><label for="enabled" style="margin:0">Enabled</label></div>
    </div>

    <div class="actions">
      <button type="submit">{{ 'Create' if is_new else 'Save' }}</button>
      <a href="/admin/postgres"><button type="button" class="secondary">Cancel</button></a>
      {% if not is_new %}
      <form class="inline-form" method="post" action="/admin/postgres/{{ target.id }}/delete"><button type="submit" class="danger">Delete</button></form>
      {% endif %}
    </div>
  </form>
</div>

<script>
async function testConnection() {
  var r = document.getElementById('test-result');
  r.textContent = 'Testing...';
  r.className = '';
  var data = new URLSearchParams();
  ['connection_mode','server_id','host','port','container_name','database_name','readonly_username','readonly_password'].forEach(function(k){
    var el = document.getElementById(k);
    if (el) data.append(k, (el.type==='checkbox' ? (el.checked ? 'true' : 'false') : el.value));
  });
  try {
    var resp = await fetch('/admin/postgres/test', {method:'POST', body: data});
    var html = await resp.text();
    r.innerHTML = html;
    var inner = r.querySelector('div');
    r.className = inner ? (inner.className.includes('success') ? 'ok' : 'err') : '';
  } catch(e) {
    r.textContent = 'Test failed: ' + e.message;
    r.className = 'err';
  }
}
</script>
{% endblock %}
