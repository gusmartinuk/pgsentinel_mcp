{% extends "base.html.j2" %}
{% block content %}
<style>
.req { color: var(--danger); font-weight: 600; }
.opt { color: var(--muted); font-size: 0.7rem; font-weight: 400; }
fieldset { border: 1px solid var(--border); border-radius: 6px; padding: 1rem; margin-bottom: 1rem; }
legend { font-size: 0.8rem; font-weight: 600; color: var(--accent); padding: 0 0.5rem; }
</style>

<h1>{{ 'New Monitoring Target' if is_new else 'Edit Monitoring Target' }}</h1>
<div class="card">
  <form method="post" action="{{ '/admin/monitoring/new' if is_new else '/admin/monitoring/' + target.id + '/edit' }}" autocomplete="off" autocapitalize="off" spellcheck="false">

    <fieldset><legend>Identity</legend>
      <div class="form-row">
        <div class="form-group"><label for="name">Name <span class="req">*</span></label><input id="name" name="name" value="{{ target.name }}" required autofocus></div>
        <div class="form-group"><label for="environment">Environment <span class="req">*</span></label>
          <select id="environment" name="environment">
            <option value="dev" {{ 'selected' if target.environment == 'dev' }}>dev</option>
            <option value="staging" {{ 'selected' if target.environment == 'staging' }}>staging</option>
            <option value="production" {{ 'selected' if target.environment == 'production' }}>production</option>
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset><legend>Endpoint</legend>
      <div class="form-row">
        <div class="form-group">
          <label for="connection_mode">Connection Mode <span class="req">*</span></label>
          <select id="connection_mode" name="connection_mode">
            <option value="https_api" {{ 'selected' if target.connection_mode == 'https_api' }}>HTTPS API</option>
            <option value="monitoring_endpoint" {{ 'selected' if target.connection_mode == 'monitoring_endpoint' }}>Monitoring Endpoint</option>
            <option value="local_network_endpoint" {{ 'selected' if target.connection_mode == 'local_network_endpoint' }}>Local Network Endpoint</option>
          </select>
        </div>
        <div class="form-group"><label for="base_url">Base URL <span class="req">*</span></label><input id="base_url" name="base_url" value="{{ target.base_url }}" placeholder="https://internal.example.com/health" required></div>
      </div>
    </fieldset>

    <fieldset><legend>Authentication</legend>
      <div class="form-group">
        <label for="api_token">API Token <span class="opt">(optional)</span></label>
        {% if not is_new %}<div class="muted" style="margin-bottom:0.25rem">Stored, leave blank to keep existing</div>{% endif %}
        <input id="api_token" name="api_token" type="password" autocomplete="new-password" placeholder="Enter token">
      </div>
    </fieldset>

    <fieldset><legend>Access Control</legend>
      <div class="form-group"><label for="allowed_operations_text">Allowed Operations <span class="req">*</span> <span class="opt">(comma-separated)</span></label><input id="allowed_operations_text" name="allowed_operations_text" value="{{ target.allowed_operations | join(', ') }}" placeholder="health,status,recent_errors" required></div>
      <div class="form-row">
        <div class="form-group" style="display:flex;align-items:center;gap:0.5rem"><input type="checkbox" id="tls_verify" name="tls_verify" value="true" {{ 'checked' if target.tls_verify }}><label for="tls_verify" style="margin:0">TLS Verify</label></div>
      </div>
    </fieldset>

    <div class="form-row">
      <div class="form-group"><label for="notes">Notes <span class="opt">(optional)</span></label><input id="notes" name="notes" value="{{ target.notes }}"></div>
      <div class="form-group" style="display:flex;align-items:center;gap:0.5rem;padding-top:1.25rem"><input type="checkbox" id="enabled" name="enabled" value="true" {{ 'checked' if target.enabled }}><label for="enabled" style="margin:0">Enabled</label></div>
    </div>

    <div class="actions">
      <button type="submit">{{ 'Create' if is_new else 'Save' }}</button>
      <a href="/admin/monitoring"><button type="button" class="secondary">Cancel</button></a>
      {% if not is_new %}
      <form class="inline-form" method="post" action="/admin/monitoring/{{ target.id }}/delete"><button type="submit" class="danger">Delete</button></form>
      {% endif %}
    </div>
  </form>
</div>
{% endblock %}
