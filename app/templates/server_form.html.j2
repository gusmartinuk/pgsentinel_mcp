{% extends "base.html.j2" %}
{% block content %}
<style>
.req { color: var(--danger); font-weight: 600; }
.opt { color: var(--muted); font-size: 0.7rem; font-weight: 400; }
fieldset { border: 1px solid var(--border); border-radius: 6px; padding: 1rem; margin-bottom: 1rem; }
legend { font-size: 0.8rem; font-weight: 600; color: var(--accent); padding: 0 0.5rem; }
</style>

<h1>{{ 'New Server' if is_new else 'Edit Server' }}</h1>
<div class="card">
  <form method="post" action="{{ '/admin/servers/new' if is_new else '/admin/servers/' + server.id + '/edit' }}" autocomplete="off" autocapitalize="off" spellcheck="false">

    <fieldset><legend>Identity</legend>
      <div class="form-row">
        <div class="form-group"><label for="name">Name <span class="req">*</span></label><input id="name" name="name" value="{{ server.name }}" required autofocus></div>
        <div class="form-group"><label for="environment">Environment <span class="req">*</span></label>
          <select id="environment" name="environment">
            <option value="dev" {{ 'selected' if server.environment == 'dev' }}>dev</option>
            <option value="staging" {{ 'selected' if server.environment == 'staging' }}>staging</option>
            <option value="production" {{ 'selected' if server.environment == 'production' }}>production</option>
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset><legend>Connection</legend>
      <div class="form-row">
        <div class="form-group"><label for="connection_mode">Connection Mode <span class="req">*</span></label>
          <select id="connection_mode" name="connection_mode">
            <option value="ssh" {{ 'selected' if server.connection_mode == 'ssh' }}>SSH</option>
            <option value="local" {{ 'selected' if server.connection_mode == 'local' }}>Local Docker</option>
            <option value="docker_exec_psql_over_ssh" {{ 'selected' if server.connection_mode == 'docker_exec_psql_over_ssh' }}>Docker over SSH</option>
            <option value="ssh_tunnel_direct_postgres" {{ 'selected' if server.connection_mode == 'ssh_tunnel_direct_postgres' }}>SSH Tunnel (PostgreSQL)</option>
          </select>
        </div>
        <div class="form-group"><label for="host">Host <span class="req">*</span> <span class="opt">(VPS IP or hostname)</span></label><input id="host" name="host" value="{{ server.host }}" placeholder="192.168.1.100" required></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label for="ssh_port">SSH Port</label><input id="ssh_port" name="ssh_port" type="number" value="{{ server.ssh_port }}" min="1" max="65535"></div>
        <div class="form-group"><label for="ssh_username">SSH Username <span class="req">*</span></label><input id="ssh_username" name="ssh_username" value="{{ server.ssh_username }}" required></div>
      </div>
    </fieldset>

    <fieldset><legend>SSH Key <span class="opt">(encrypted in vault)</span></legend>
      <div class="form-group">
        <label for="ssh_private_key">SSH Private Key <span class="req">*</span></label>
        {% if not is_new %}<div class="muted" style="margin-bottom:0.25rem">Stored, leave blank to keep existing key</div>{% endif %}
        <textarea id="ssh_private_key" name="ssh_private_key" placeholder="Paste SSH private key here (PEM format)" {{ 'required' if is_new }}>{{ '' if not is_new else server.ssh_private_key }}</textarea>
      </div>
      <div class="form-group"><label for="ssh_private_key_passphrase">Key Passphrase <span class="opt">(optional)</span></label><input id="ssh_private_key_passphrase" name="ssh_private_key_passphrase" type="password" autocomplete="new-password" placeholder="Leave blank if key has no passphrase"></div>
    </fieldset>

    <fieldset><legend>Access Control</legend>
      <div class="form-group"><label for="allowed_containers_text">Allowed Containers <span class="opt">(comma-separated, blank = none unless allow-all is checked)</span></label><input id="allowed_containers_text" name="allowed_containers_text" value="{{ server.allowed_containers | join(', ') }}" placeholder="app,postgres"></div>
      <div class="form-group" style="display:flex;align-items:center;gap:0.5rem"><input type="checkbox" id="allow_all_containers" name="allow_all_containers" value="true" {{ 'checked' if server.allow_all_containers }}><label for="allow_all_containers" style="margin:0">Allow all containers for this server</label></div>
      <div class="form-group"><label for="allowed_log_sources_text">Allowed Log Sources <span class="opt">(comma-separated)</span></label><input id="allowed_log_sources_text" name="allowed_log_sources_text" value="{{ server.allowed_log_sources | join(', ') }}" placeholder="app,postgres"></div>
    </fieldset>

    <div class="form-row">
      <div class="form-group"><label for="notes">Notes <span class="opt">(optional)</span></label><input id="notes" name="notes" value="{{ server.notes }}"></div>
      <div class="form-group" style="display:flex;align-items:center;gap:0.5rem;padding-top:1.25rem"><input type="checkbox" id="enabled" name="enabled" value="true" {{ 'checked' if server.enabled }}><label for="enabled" style="margin:0">Enabled</label></div>
    </div>

    <div class="actions">
      <button type="submit">{{ 'Create' if is_new else 'Save' }}</button>
      <a href="/admin/servers"><button type="button" class="secondary">Cancel</button></a>
      {% if not is_new %}
      <form class="inline-form" method="post" action="/admin/servers/{{ server.id }}/delete"><button type="submit" class="danger">Delete</button></form>
      {% endif %}
    </div>
  </form>
</div>
{% endblock %}
