{% extends "base.html.j2" %}
{% block content %}
<h1>PostgreSQL Targets</h1>

<div class="actions" style="margin-bottom:1rem">
  <a href="/admin/postgres/new"><button>Add Target</button></a>
</div>

{% if not targets %}
<div class="card"><p class="muted">No PostgreSQL targets defined.</p></div>
{% else %}
<table>
  <thead><tr><th>Name</th><th>Server</th><th>Mode</th><th>Database</th><th>Container</th><th>Tables</th><th>Status</th><th></th></tr></thead>
  <tbody>
  {% for t in targets %}
  <tr>
    <td><strong>{{ t.name }}</strong></td>
    <td>{{ t.server_id }}</td>
    <td>{{ t.connection_mode }}</td>
    <td>{{ t.database_name }}</td>
    <td>{{ t.container_name }}</td>
    <td>{{ t.allowed_tables | length }}</td>
    <td><span class="badge badge-{{ 'green' if t.enabled else 'red' }}">{{ 'enabled' if t.enabled else 'disabled' }}</span></td>
    <td><a href="/admin/postgres/{{ t.id }}/edit">edit</a></td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}
{% endblock %}
