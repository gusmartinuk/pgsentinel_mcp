<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>PgSentinel MCP</title>
<style>
:root {
  --bg: #0d1117;
  --fg: #c9d1d9;
  --border: #30363d;
  --accent: #58a6ff;
  --danger: #f85149;
  --warning: #d2991d;
  --success: #3fb950;
  --muted: #8b949e;
  --card-bg: #161b22;
  --input-bg: #0d1117;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', monospace; background: var(--bg); color: var(--fg); line-height: 1.5; min-height: 100vh; }
nav { background: var(--card-bg); border-bottom: 1px solid var(--border); padding: 0 1.5rem; display: flex; align-items: center; gap: 1.5rem; height: 48px; }
nav a { color: var(--accent); text-decoration: none; font-size: 0.875rem; }
nav a:hover { text-decoration: underline; }
nav .brand { font-weight: 600; color: var(--fg); margin-right: auto; }
.container { max-width: 960px; margin: 2rem auto; padding: 0 1.5rem; }
.card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 6px; padding: 1.5rem; margin-bottom: 1rem; }
h1 { font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem; color: var(--accent); }
h2 { font-size: 1rem; font-weight: 600; margin-bottom: 0.75rem; }
table { width: 100%; border-collapse: collapse; margin: 0.5rem 0; }
th, td { padding: 0.5rem 0.75rem; text-align: left; border-bottom: 1px solid var(--border); font-size: 0.875rem; }
th { color: var(--muted); font-weight: 600; }
tr:hover { background: rgba(255,255,255,0.03); }
label { display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.25rem; color: var(--muted); }
input, select, textarea { width: 100%; padding: 0.5rem 0.75rem; background: var(--input-bg); border: 1px solid var(--border); border-radius: 6px; color: var(--fg); font-family: monospace; font-size: 0.875rem; }
input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); }
input[type="checkbox"] { width: auto; margin-right: 0.5rem; }
textarea { min-height: 100px; resize: vertical; }
button, .btn { padding: 0.5rem 1rem; background: var(--accent); color: #fff; border: none; border-radius: 6px; font-size: 0.875rem; font-weight: 500; cursor: pointer; font-family: inherit; }
button:hover { opacity: 0.9; }
button.danger { background: var(--danger); }
button.secondary { background: var(--card-bg); border: 1px solid var(--border); color: var(--fg); }
.form-group { margin-bottom: 1rem; }
.form-row { display: flex; gap: 1rem; }
.form-row .form-group { flex: 1; }
.error { color: var(--danger); background: rgba(248,81,73,0.1); border: 1px solid var(--danger); border-radius: 6px; padding: 0.75rem; margin-bottom: 1rem; font-size: 0.875rem; }
.success { color: var(--success); background: rgba(63,185,80,0.1); border: 1px solid var(--success); border-radius: 6px; padding: 0.75rem; margin-bottom: 1rem; font-size: 0.875rem; }
.warning { color: var(--warning); }
.key-display { background: var(--bg); border: 1px solid var(--warning); border-radius: 6px; padding: 1rem; font-family: monospace; font-size: 0.75rem; word-break: break-all; color: var(--warning); margin: 0.75rem 0; }
.badge { display: inline-block; padding: 0.125rem 0.5rem; border-radius: 12px; font-size: 0.75rem; font-weight: 500; }
.badge-green { background: rgba(63,185,80,0.2); color: var(--success); }
.badge-red { background: rgba(248,81,73,0.2); color: var(--danger); }
.badge-yellow { background: rgba(210,153,29,0.2); color: var(--warning); }
.badge-gray { background: rgba(139,148,158,0.2); color: var(--muted); }
.actions { display: flex; gap: 0.5rem; margin-top: 1rem; }
.muted { color: var(--muted); font-size: 0.8rem; }
.meta { display: flex; gap: 2rem; flex-wrap: wrap; margin-bottom: 1rem; }
.meta-item { display: flex; flex-direction: column; }
.meta-label { font-size: 0.75rem; color: var(--muted); }
.meta-value { font-size: 1.25rem; font-weight: 600; }
.inline-form { display: inline; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
pre { background: var(--bg); padding: 1rem; border-radius: 6px; overflow-x: auto; font-size: 0.75rem; max-height: 400px; overflow-y: auto; }
</style>
</head>
<body>
{% if vault_is_unlocked is not defined or vault_is_unlocked %}
<nav>
  <span class="brand">PgSentinel MCP</span>
  <a href="/admin/dashboard">Dashboard</a>
  <a href="/admin/servers">Servers</a>
  <a href="/admin/postgres">PostgreSQL</a>
  <a href="/admin/monitoring">Monitoring</a>
  <a href="/admin/vaults">Vaults</a>
  <a href="/admin/agent">Agent Key</a>
  <a href="/admin/settings">Settings</a>
  <a href="/admin/audit">Audit</a>
  <form class="inline-form" method="post" action="/admin/lock"><button class="secondary" type="submit">Lock</button></form>
</nav>
{% endif %}
<div class="container">
{% block content %}{% endblock %}
</div>
</body>
</html>
