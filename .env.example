PGSENTINEL_PORT=8088
PGSENTINEL_DATA_DIR=/secure/pgsentinel
PGSENTINEL_VAULT=/secure/pgsentinel/vault.enc
# Optional multi-vault mode:
# PGSENTINEL_VAULT_DIR=/secure/pgsentinel/vaults
# PGSENTINEL_ACTIVE_VAULT_FILE=/secure/pgsentinel/vaults/.active_vault
# Recommended persistent SSH host keys path:
# single-vault: /secure/pgsentinel/known_hosts
# multi-vault: /secure/pgsentinel/vaults/known_hosts
# PGSENTINEL_SSH_KNOWN_HOSTS=/secure/pgsentinel/vaults/known_hosts
PGSENTINEL_REQUIRE_EXISTING_VAULT=true
PGSENTINEL_COOKIE_SECURE=true
PGSENTINEL_ALLOW_LEGACY_CONFIG=false
PGSENTINEL_AUDIT_LOG=/var/log/pgsentinel/audit.log
PGSENTINEL_MCP_HTTP_ENABLED=true
